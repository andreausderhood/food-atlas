{% macro chip(c, sources, compact=false) -%}
<span class="chip tier-{{ c.tier }}" tabindex="0" title="{{ sources[c.src].title }} · {{ c.src }} · {{ sources[c.src].license }}{% if c.ref %} · {{ c.ref }}{% endif %} · T{{ c.tier }} · {{ c.derivation }}">T{{ c.tier }}{% if not compact %} · {{ c.derivation }} · {{ c.src }}{% endif %}</span>
{%- endmacro %}
