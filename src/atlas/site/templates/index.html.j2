{% extends "base.html.j2" %}
{% from "_chip.html.j2" import chip %}
{% block title %}Foods | Food Atlas{% endblock %}
{% block main %}
<div class="intro"><p class="eyebrow">The food library</p><h1>Explore what’s in a food.</h1><p class="muted">{{ rows|length }} foods, cultivars, parts and forms. {{ "{:,}".format(payload.stats.accepted) }} accepted claims, with their sources kept visible.</p></div>
{% set categories = namespace(labels=[]) %}
{% for r in rows %}{% for label in r.research|default([]) %}{% if label not in categories.labels %}{% set categories.labels = categories.labels + [label] %}{% endif %}{% endfor %}{% endfor %}
<div class="library">
<aside class="filters" aria-label="Food filters">
<div class="filter-top"><h2>Refine library</h2><button id="reset" class="text-button" type="button">Reset filters</button></div>
<label>Food family<select id="family"><option value="">All families</option>{% for id, name in families.items() %}<option value="{{ id }}">{{ name }}</option>{% endfor %}</select></label>
<label>Food level<select id="level"><option value="">All levels</option>{% for id, name in level_label.items() %}<option value="{{ id }}">{{ name }}</option>{% endfor %}</select></label>
<label>Evidence<select id="evidence"><option value="">Any evidence</option>{% for tier, name in tier_label.items() %}<option value="{{ tier }}">T{{ tier }} · {{ name }}</option>{% endfor %}<option value="none">No claims yet</option></select></label>
<label>Research category<select id="research"><option value="">All research categories</option>{% for label in categories.labels|sort %}<option value="{{ label }}">{{ label }}</option>{% endfor %}<option value="unclassified">Evidence not classified</option></select></label>
<label class="check"><input id="saved-only" type="checkbox">Saved foods only <span id="saved-count"></span></label>
<details><summary class="filter-help">How to read this library</summary><p class="filter-help">Families group entries by their top-level registered taxon, not botanical family rank. A tier describes an individual claim, not the entire food.</p><p class="filter-help">Editorial descriptions are declared, not measured. Missing nutrition is not zero.</p><p class="filter-help">Research categories list only recorded labels; entries without labels stay unclassified, never claimed.</p></details>
</aside>
<section aria-label="Food results">
<div class="discovery-search">
<label for="q">Include keywords or phrases<input id="q" type="search" placeholder='apple "vitamin c" -dried' autocomplete="off" aria-describedby="search-help"></label>
<label for="exclude">Exclude keywords or phrases<input id="exclude" type="search" placeholder='dried "apple juice"' autocomplete="off" aria-describedby="search-help"></label>
<p id="search-help" class="filter-help">Keyword search, not question answering. All included terms must match; any excluded term removes a food. Use double quotes for a phrase or a minus sign to exclude in the include field. Matches recorded text, not proven health effects.</p>
</div>
<style>.discovery-search{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}.discovery-search label{min-width:0}.discovery-search p{grid-column:1/-1;margin:0}@media(max-width:600px){.discovery-search{grid-template-columns:1fr}}</style>
<div class="results-bar"><span id="result-count" role="status" aria-live="polite">{{ rows|length }} foods</span><div class="view-buttons" role="group" aria-label="Display mode"><button id="view-cards" type="button" aria-pressed="true">Cards</button><button id="view-list" type="button" aria-pressed="false">List</button></div></div>
<p id="season-unknown-count" class="filter-help" role="status" aria-live="polite" hidden></p>
<div class="grid" id="grid">
{% for r in rows %}
<article class="card" data-id="{{ r.id }}" data-search="{{ r.search }}" data-family="{{ r.family }}" data-level="{{ r.level }}" data-tiers="{{ r.tiers|join(',') }}" data-research='{{ r.research|default([])|tojson }}' data-seasons='{{ r.seasons|default([])|tojson }}'>
{% set compact = true %}{% set plant_image = image_for(r.id) %}{% include "_plant_image.html.j2" %}{% set compact = false %}
<div class="card-body"><div class="card-heading"><span class="badge">{{ level_label[r.level] }}</span><span class="card-number">{{ r.molecules }} molecules</span></div>
<div><h2><a href="foods/{{ r.slug }}.html">{{ r.name }}</a></h2><div class="taxon muted">{{ r.taxon_name }}</div></div>
{% if r.preview %}<p class="preview">{{ r.preview.v }}</p>{{ chip(r.preview, sources) }}{% else %}<p class="preview muted">No editorial description yet. Open the entry to explore available evidence and questions.</p><span class="card-evidence">{% if r.claims %}No editorial claim{% else %}No claims yet{% endif %}</span>{% endif %}
<div class="discovery-research" aria-label="Research classification">{% for label in r.research|default([]) %}<span class="badge">{{ label }}</span>{% else %}<span class="muted">Evidence not classified</span>{% endfor %}</div>
</div>
<div class="card-actions"><span class="card-meta">{{ r.claims }} claims<br>{% if r.nutrition %}{{ r.nutrition }} nutrition values{% else %}Nutrition not stated{% endif %}</span><button type="button" data-save="{{ r.id }}" aria-pressed="false" aria-label="Save {{ r.name }}">Save</button><button type="button" data-compare="{{ r.id }}" aria-pressed="false" aria-label="Compare {{ r.name }}">Compare +</button></div>
</article>
{% endfor %}
</div>
<div id="empty" class="empty" hidden><h2>No foods match.</h2><p>Try a broader search or reset the filters. Saved foods are stored only in this browser.</p><button type="button" id="empty-reset">Reset filters</button></div>
<noscript><p class="notice">All entries are listed. Search, filters, saved foods and the compare tray need JavaScript; food pages and the initial comparison remain readable.</p></noscript>
</section></div>
{% endblock %}
{% block scripts %}<script>{% include "_discovery.js.j2" %}</script>{% endblock %}
