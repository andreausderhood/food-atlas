{% extends "base.html.j2" %}
{% from "_chip.html.j2" import chip %}
{% block title %}{{ food.name }} — Food Atlas{% endblock %}
{% block main %}
{% include "_masthead.html.j2" %}
{% include "_profiles.html.j2" %}
<div class="profile-grid">
<section class="profile" aria-label="Nutrition profile">{% include '_nutrition.html.j2' %}</section>
</div>
<div class="entry-depth">
<details><summary>Varieties &amp; relatives <span>{{ related|length }} related entries</span></summary><p class="muted">Linked by top-level registered taxon; not interchangeable in nutrition or use.</p><ul class="relative-list">{% for r in related %}<li><a href="{{ slug(r.id) }}.html">{{ r.name }}</a> <em>{{ r.taxon_name }}</em> <span class="muted">{{ level_label[r.level] }}</span></li>{% else %}<li>No related entries in this collection yet.</li>{% endfor %}</ul></details>
<details><summary>Growing here <span>Region &amp; season</span></summary><p data-entry-seasons='{{ row.seasons|tojson }}'>Choose a region, month and harvest type above. Missing regional data is not evidence of absence.</p>
{% for group, claims in sections if group in ('growing','season','origin','geography') %}<h3>{{ group|capitalize }}</h3>{% for c in claims %}<p>{{ c.label }}: {{ c.display }} {{ chip(c, sources, compact=true) }}</p>{% endfor %}{% else %}<p class="muted">No sourced cultivation guidance for this entry yet.</p>{% endfor %}</details>
<details><summary>Culinary &amp; technical uses <span>Preparation &amp; transformations</span></summary>
{% for group, claims in sections if group in ('process','narrative') %}{% for c in claims if c.field != 'eli5' %}<p>{{ c.display }} {{ chip(c, sources, compact=true) }}</p>{% endfor %}{% endfor %}
<ul>{% for r in related if r.level == 'form' %}<li><a href="{{ slug(r.id) }}.html">{{ r.name }}</a> — related preparation, not automatically a use of this specific entry</li>{% else %}<li>No linked technical preparations yet.</li>{% endfor %}</ul></details>
</div>
<details class="register"><summary>Measurements &amp; sources
  <span>Every quantity with its unit, basis, food part and source</span></summary>
{% set has_nutrition = sections | selectattr("0", "equalto", "nutrition") | list %}
{% if not has_nutrition %}<p class="muted">Nutrition not yet available for this entry — no sourced values pass the contract.</p>{% endif %}
{% for group, claims in sections %}<h3 id="{{ group }}">{{ group|capitalize }}</h3>
{% if group == "nutrition" %}<p class="muted">Amounts per 100 g edible portion. Basis and part are source-specific; these values are not interchangeable.</p>{% endif %}
<div class="scroll"><table><tr><th>What</th><th>Value</th><th>Basis · part</th><th>Evidence</th></tr>
{% for c in claims %}<tr><td>{{ c.label }}{% if c.machine_extracted %} <span class="badge">machine-extracted / unvalidated</span>{% endif %}</td><td>{{ c.display }}</td><td>{{ c.basis or "—" }} · {{ c.food_part or "—" }}{% if c.method %}<br><span class="method">Method: {{ c.method }}</span>{% elif group == "bioactivity" %}<br><span class="method">Method: not reported</span>{% endif %}</td><td>{{ chip(c, sources) }}{% if c.machine_extracted and c.pmcs %}<br>{% for pmc in c.pmcs %}<a href="https://pmc.ncbi.nlm.nih.gov/articles/{{ pmc }}/">{{ pmc }}</a> {% endfor %}{% endif %}</td></tr>{% endfor %}</table></div>
{% else %}<p class="muted">No sourced technical values yet.</p>{% endfor %}</details>
<details class="entry-gaps"><summary>Open questions for this entry <span>{{ food.gaps|length }} gaps</span></summary>{% for g in food.gaps %}<p><span class="badge">Rule {{ g.rule }}</span> {{ g.field }}: {{ g.question }} <span class="muted">Would be settled by: {{ g.would_be_settled_by }}</span></p>{% else %}<p class="muted">None.</p>{% endfor %}</details>
{% endblock %}
