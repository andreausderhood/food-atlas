/* Native static library UI. Radius: 6px controls, 10px panels. */
.season-toolbar{max-width:1440px;margin:auto;padding:14px 32px;display:grid;grid-template-columns:minmax(140px,180px) minmax(130px,160px) minmax(140px,180px) 1fr;gap:16px;border-bottom:1px solid var(--ink-15);align-items:end}.season-toolbar p{font-size:12px;margin:0 0 10px}.entry-heading{max-width:1000px;margin-bottom:28px}.entry-heading h1 em{display:block;font:italic 24px/1.4 Georgia,serif;color:var(--ink-55);letter-spacing:0;margin-top:12px}.entry-intro{font:22px/1.5 Georgia,serif;max-width:70ch}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:11px;color:var(--ink-55)}.profile-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr) minmax(0,1fr);gap:28px;margin-block:40px}.profile{min-width:0;border-top:2px solid var(--ink);padding-top:20px}.profile h2{margin-top:0;font-size:24px}.profile p{font-size:14px}.profile>.nutrition-profile{border:0;margin:0;padding:0}.profile .nutrition-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.profile .nutrition-tile{padding:8px 0;background:transparent}.profile .nutrition-tile h5{font-size:12px}.profile .nutrition-profile>p{font-size:12px}.entry-depth{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.entry-depth>details,.technical-record,.entry-gaps{border-top:1px solid var(--ink-15);padding:20px 0;min-width:0}.entry-depth summary,.technical-record>summary,.entry-gaps>summary{font-size:18px;font-weight:600;cursor:pointer}.entry-depth summary span,.technical-record>summary span,.entry-gaps>summary span{display:block;font-size:12px;font-weight:400;color:var(--ink-55);margin-top:6px}.relative-list{padding-left:20px}.relative-list li{margin:12px 0}.relative-list em{display:block;color:var(--ink-55);font-size:12px}.technical-record{margin-top:30px}.editorial-copy .editorial-line{align-items:start}.empty{padding:16px;border:1px dashed var(--ink-15)}.profile details>summary{cursor:pointer}.profile .nutrition-science{margin-top:6px}.profile .nutrition-live{font-size:11px}.profile .nutrition-record{padding-top:0}.profile .nutrition-profile select{font-size:12px}.masthead{flex-wrap:wrap}
@media(max-width:1050px){.profile-grid{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr)}.profile-grid>.profile:last-child{grid-column:1/-1}.season-toolbar{grid-template-columns:repeat(3,minmax(0,1fr))}.season-toolbar p{grid-column:1/-1;margin:0}.entry-depth{grid-template-columns:1fr}}
@media(max-width:640px){.season-toolbar{padding:12px 16px;gap:8px}.season-toolbar label{font-size:11px}.season-toolbar input,.season-toolbar select{padding:8px 6px;font-size:12px}.profile-grid{grid-template-columns:1fr;gap:24px;margin-block:24px}.profile-grid>.profile:last-child{grid-column:auto}.entry-intro{font-size:19px}.entry-heading h1 em{font-size:20px}}

