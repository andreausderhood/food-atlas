/* Plant photography: provenance stays visible, reference images never pass as identification. */
.plant-image{margin:0 0 20px;max-width:640px}
.plant-image img{display:block;width:100%;height:auto;border:1px solid var(--ink-15)}
.plant-image figcaption{font-size:11px;line-height:1.6;color:var(--ink-55);margin-top:6px}
.plant-image figcaption a{color:var(--ink-55)}
.plant-image .image-reference{font-style:italic}
.card .plant-image{margin:0}
.card .plant-image img{border:0;aspect-ratio:4/3;object-fit:cover}
.grid.list .card .plant-image{display:none}
