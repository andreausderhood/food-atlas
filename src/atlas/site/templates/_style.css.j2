r(--ink-15)}.editorial-claim h3{margin:0 0 10px}.editorial-claim p{max-width:75ch;margin:0 0 12px}.technical{border-top:1px solid var(--ink-15);padding:18px 0}.technical summary{cursor:pointer;font-size:20px;font-weight:600;letter-spacing:-.02em}.technical summary span{font-size:12px;color:var(--ink-55);font-weight:400;margin-left:10px}.technical[open] summary{margin-bottom:18px}.scroll{overflow:auto;max-width:100%;border:1px solid var(--ink-15)}table{width:100%;border-collapse:collapse;font-size:13px}caption{text-align:left;padding:12px;font-weight:600;background:var(--paper-2)}th,td{border-bottom:1px solid var(--ink-15);padding:12px;text-align:left;vertical-align:top}th{font-weight:600;background:var(--paper-2)}td{overflow-wrap:anywhere}tr:last-child td,tr:last-child th{border-bottom:0}.claim{margin:0 0 16px}.claim:last-child{margin:0}.related{border-left:1px solid var(--ink-15);padding-left:24px}.related h2{font-size:18px}.related h3{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-55);margin-top:24px}.related a{display:block;padding:6px 0;font-size:13px;text-decoration:none;color:var(--ink)}.related a:hover{color:var(--accent)}.molecule-search{max-width:500px;margin:18px 0}.molecule-row{border-top:1px solid var(--ink-15);padding:16px 0}.molecule-row summary{cursor:pointer;display:flex;gap:16px;justify-content:space-between;align-items:center;font-weight:600;font-size:17px}.molecule-row summary span{font-weight:400;font-size:12px;color:var(--ink-55)}.molecule-row[open] summary{margin-bottom:18px}.compare-picks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:26px 0}.compare-tray{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);width:min(1000px,calc(100% - 32px));padding:14px 18px;background:var(--paper-2);border:1px solid var(--accent);display:flex;gap:14px;align-items:center;z-index:3;font-size:13px}#tray-items{display:flex;flex-wrap:wrap;gap:6px;flex:1}#tray-items button{font-size:12px;min-heig