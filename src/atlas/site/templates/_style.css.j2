@media(prefers-color-scheme:dark){:root:not([data-theme=light]){color-scheme:dark;--bg:#191a17;--fg:#f0ede5;--muted:#b4b0a5;--accent:#ff7396;--line:#41423a;--card:#23241f;--soft:#30312b;--t1:#85cfa0;--t2:#96badf;--t3:#e0ca81;--t4:#e6ac85;--t5:#ffa5a9}}
*{box-sizing:border-box}[hidden]{display:none!important}:focus-visible{outline:3px solid var(--accent);outline-offset:3px}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--accent);text-underline-offset:3px}button,input,select{font:inherit;color:inherit}button,.button{border:1px solid var(--line);background:var(--card);border-radius:6px;padding:8px 12px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px}button:hover,.button:hover{border-color:var(--accent)}button[aria-pressed=true],.primary{background:var(--accent);color:var(--bg);border-color:var(--accent)}button:disabled{opacity:.5;cursor:not-allowed}input,select{border:1px solid var(--line);border-radius:6px;background:var(--card);padding:10px 12px;width:100%;min-height:44px}input::placeholder{color:var(--muted)}input[type=checkbox]{width:18px;min-height:18px;accent-color:var(--accent)}label{display:block;font-size:13px;font-weight:600}label input,label select{margin-top:6px}.skip{position:absolute;left:16px;top:-100px;z-index:5;background:var(--card);padding:12px}.skip:focus{top:8px}.masthead{max-width:1560px;margin:auto;display:flex;align-items:center;gap:28px;padding:18px 32px;border-bottom:1px solid var(--line)}.brand{color:var(--fg);text-decoration:none;font-size:22px;font-weight:750;letter-spacing:-.8px;white-space:nowrap}.brand span{font-size:12px;letter-spacing:0;font-weight:400;color:var(--muted);display:block}.masthead nav{display:flex;gap:24px;margin-left:auto}.masthead nav a{font-size:14px;text-decoration:none;color:var(--muted)}.masthead nav a[aria-current=page]{color:var(--accent);font-weight:700}main{max-width:1440px;margin:0 auto;padding:36px 32px 60px}footer{max-width:1440px;margin:auto;padding:20px 32px 110px;border-top:1px solid var(--line);font-size:12px}h1,h2,h3{line-height:1.16;letter-spacing:-.035em}h1{font-size:clamp(32px,4vw,48px);font-weight:650;margin:0 0 12px}h2{font-size:24px;margin:0 0 18px}h3{font-size:18px}.muted{color:var(--muted)}.intro{margin-bottom:28px;max-width:75ch}.intro p{margin:0}.eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:.1em;font-weight:650;color:var(--accent);margin:0 0 10px}.library{display:grid;grid-template-columns:210px minmax(0,1fr);gap:32px}.filters{border-right:1px solid var(--line);padding-right:24px}.filters>label,.filters>details{margin-bottom:22px}.filters h2{font-size:15px;letter-spacing:0}.filter-help{font-size:12px;color:var(--muted)}.filter-top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px}.filter-top h2{margin:0}.text-button{padding:0;min-height:24px;border:none;background:transparent;color:var(--accent);font-size:12px}.check{display:flex;align-items:center;gap:8px}.check input{margin:0}.search-row{display:flex;gap:12px;align-items:flex-end}.search-row label{flex:1}.results-bar{display:flex;align-items:center;gap:16px;justify-content:space-between;margin:20px 0 16px;font-size:13px}.view-buttons{display:flex;gap:6px}.view-buttons button{min-height:32px;padding:4px 10px;font-size:12px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}.card{min-width:0;display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}.card-body{padding:20px;flex:1}.card-heading{display:flex;justify-content:space-between;gap:10px}.card h2{font-size:25px;margin:12px 0 6px}.card h2 a{color:var(--fg);text-decoration:none}.card h2 a:hover{color:var(--accent)}.card .taxon{font-size:12px;min-height:35px;overflow-wrap:anywhere}.card .preview{font-size:13px;margin:16px 0 10px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.card-actions{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-top:1px solid var(--line);gap:8px}.card-actions button{font-size:12px;padding:5px 9px;min-height:32px}.card-meta{font-size:11px;color:var(--muted)}.badge{font-size:11px;border:1px solid var(--line);border-radius:4px;padding:3px 6px;background:var(--soft);display:inline-block}.card-number{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}.chip{display:inline-block;font:11px/1.5 ui-monospace,Menlo,monospace;border:1px solid currentColor;border-radius:5px;padding:2px 6px;max-width:100%;overflow-wrap:anywhere;white-space:normal;letter-spacing:0}.tier-1{color:var(--t1)}.tier-2{color:var(--t2)}.tier-3{color:var(--t3)}.tier-4{color:var(--t4)}.tier-5{color:var(--t5)}.grid.list{display:block}.grid.list .card{margin-bottom:8px;flex-direction:row}.grid.list .card-body{display:grid;grid-template-columns:85px minmax(170px,1fr) minmax(180px,1.5fr);gap:12px;align-items:center;padding:16px}.grid.list .card-heading{display:block}.grid.list .card-number,.grid.list .preview,.grid.list .card-body>.chip{display:none}.grid.list .card h2{font-size:19px;margin:0}.grid.list .taxon{min-height:0}.grid.list .card-actions{border-top:0;border-left:1px solid var(--line);flex-wrap:wrap;max-width:210px}.empty,.notice{padding:22px;border:1px solid var(--line);border-radius:8px;background:var(--soft)}.empty h2,.notice h3{margin:0 0 8px}.empty{margin:24px 0}.notice{font-size:13px;margin:24px 0}.breadcrumb{font-size:13px;margin-bottom:20px}.entry-header{padding-bottom:26px;border-bottom:1px solid var(--line);margin-bottom:30px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.entry-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:40px}.entry-layout>*,.layers>section{min-width:0}.section{margin:0 0 36px}.editorial-claim{padding:18px 0;border-top:1px solid var(--line)}.editorial-claim h3{margin:0 0 10px}.editorial-claim p{max-width:75ch;margin:0 0 12px}.technical{border-top:1px solid var(--line);padding:18px 0}.technical summary{cursor:pointer;font-size:20px;font-weight:600;letter-spacing:-.02em}.technical summary span{font-size:12px;color:var(--muted);font-weight:400;margin-left:10px}.technical[open] summary{margin-bottom:18px}.scroll{overflow:auto;max-width:100%;border:1px solid var(--line);border-radius:6px}table{width:100%;border-collapse:collapse;font-size:13px}caption{text-align:left;padding:12px;font-weight:600;background:var(--soft)}th,td{border-bottom:1px solid var(--line);padding:12px;text-align:left;vertical-align:top}th{font-weight:600;background:var(--soft)}td{overflow-wrap:anywhere}tr:last-child td,tr:last-child th{border-bottom:0}.claim{margin:0 0 16px}.claim:last-child{margin:0}.related{border-left:1px solid var(--line);padding-left:24px}.related h2{font-size:18px}.related h3{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-top:24px}.related a{display:block;padding:6px 0;font-size:13px;text-decoration:none;color:var(--fg)}.related a:hover{color:var(--accent)}.molecule-search{max-width:500px;margin:18px 0}.molecule-row{border-top:1px solid var(--line);padding:16px 0}.molecule-row summary{cursor:pointer;display:flex;gap:16px;justify-content:space-between;align-items:center;font-weight:600;font-size:17px}.molecule-row summary span{font-weight:400;font-size:12px;color:var(--muted)}.molecule-row[open] summary{margin-bottom:18px}.compare-picks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:26px 0}.compare-tray{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);width:min(1000px,calc(100% - 32px));padding:14px 18px;background:var(--card);border:1px solid var(--accent);border-radius:10px;box-shadow:0 8px 36px #0002;display:flex;gap:14px;align-items:center;z-index:3;font-size:13px}#tray-items{display:flex;flex-wrap:wrap;gap:6px;flex:1}#tray-items button{font-size:12px;min-height:32px;padding:5px 8px}.status:empty{display:none}.status{position:fixed;bottom:110px;left:50%;transform:translateX(-50%);padding:12px 18px;background:var(--fg);color:var(--bg);border-radius:6px;z-index:4;font-size:13px}.gap-item{padding:18px 0;border-top:1px solid var(--line)}.gap-item p{margin:8px 0}.section-nav{display:flex;gap:18px;flex-wrap:wrap;font-size:13px;margin-top:22px}.source-title{min-width:220px}
@media(max-width:1050px){.masthead{gap:18px;padding:16px 24px}.brand span{display:none}.masthead nav{gap:16px}.grid.list .card-body{display:block}.grid.list .card h2{margin:8px 0}.entry-layout{grid-template-columns:minmax(0,1fr) 210px}.library{grid-template-columns:180px minmax(0,1fr);gap:24px}}
@media(max-width:767px){.masthead{flex-wrap:wrap;padding:16px;gap:12px}.masthead nav{order:3;width:100%;overflow:auto;gap:22px}.masthead #theme{margin-left:auto}.brand span{display:inline;font-size:11px;margin-left:12px}main{padding:28px 16px 40px}.library,.entry-layout{grid-template-columns:1fr;gap:24px}.filters{border:0;border-bottom:1px solid var(--line);padding:0 0 18px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.filters>label,.filters>details{margin:0}.filter-top,.filters>details{grid-column:1/-1}.filter-top{margin:0}.filters h2{font-size:16px}.grid{grid-template-columns:1fr}.grid.list .card{display:block}.grid.list .card-actions{border:0;border-top:1px solid var(--line);max-width:none}.related{border:0;border-top:1px solid var(--line);padding:24px 0}.compare-picks{grid-template-columns:1fr;gap:12px}.compare-tray{flex-wrap:wrap;bottom:8px;padding:12px;gap:8px}.compare-tray>strong{display:none}#tray-items{flex-basis:100%}.compare-tray .button,.compare-tray>button{min-height:32px;font-size:12px}.status{bottom:160px;width:calc(100% - 32px)}.molecule-row summary{align-items:flex-start;overflow-wrap:anywhere}.brand{font-size:20px}footer{padding:20px 16px 180px}.scroll table{min-width:560px}.results-bar{gap:8px}.intro{margin-bottom:24px}}
@media(prefers-reduced-motion:no-preference){button,a{transition:background-color .15s,color .15s,border-color .15s}}
